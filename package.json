{
  "name": "fashionista-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "nodemon server.js",
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm start\"",
